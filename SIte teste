<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Exemplo HTML, CSS e JavaScript</title>

  <!-- CSS -->
  <style>
    body {
      font-family: Arial;
      text-align: center;
      background-color: #ffffff;
    }
    h1 {
      color: darkblue;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      background-color: green;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    button:hover {
      background-color: darkgreen;
    }
  </style>
</head>
<body>

  <!-- HTML -->
  <h1>Site interativo professor</h1>
  <p>Clique no botao abaixo:</p>
  <button onclick="mostrarMensagem()">Clique aqui</button>

  <!-- JavaScript -->
  <script>
    function mostrarMensagem() {
      alert("Clicou namoral.");
    }
  </script>
</body>
</html>
